[Unit]
Description=Crunchy Bag Celery Beat Scheduler
After=network.target redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/crunchy_back
ExecStart=/opt/crunchy_back/.venv/bin/celery -A crunchy_backend beat -l info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
