# Crunchy Backend - Environment Configuration Template
SECRET_KEY=django-insecure-crunchy-rms-super-secret-key-change-in-production-!@#$
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],crunchybag.com,www.crunchybag.com

# Database Configuration (Defaults to SQLite for local development, or postgresql://user:pass@localhost:5432/crunchy_db)
DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration (Used for Caching, Celery Broker & Channels Layer)
REDIS_URL=redis://127.0.0.1:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Django Channels Configuration (Set to 'redis' when Redis is available, or 'inmemory' for zero-dependency local dev)
CHANNEL_LAYER_TYPE=inmemory

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://crunchybag.com,https://www.crunchybag.com

# CSRF Trusted Origins (Required for HTTPS POST in Django 4.0+)
CSRF_TRUSTED_ORIGINS=https://crunchybag.com,https://www.crunchybag.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:8000


